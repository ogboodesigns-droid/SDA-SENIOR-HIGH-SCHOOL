# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://sda_shs:change-me@localhost:5432/sda_shs

# ── API ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PORT=4000
# Browser origins allowed to call the API directly (the admin portal talks to it server-side).
CORS_ORIGINS=http://localhost:3000
# Set to 1 when the API runs behind one reverse proxy (nginx, Caddy, a load balancer).
TRUST_PROXY_HOPS=0

# File uploads: "local" (disk) or "s3" (any S3-compatible storage)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Push notifications through Expo
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# ── First-time setup (pnpm db:bootstrap) ─────────────────────────────────
SCHOOL_NAME=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Admin portal ──────────────────────────────────────────────────────────
API_URL=http://localhost:4000
