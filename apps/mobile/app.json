{
  "expo": {
    "name": "SDA SHS",
    "slug": "sda-shs",
    "scheme": "sdashs",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "description": "S.D.A Senior High School, Asokore-Koforidua \u2014 Knowledge for Excellence",
    "android": {
      "package": "org.sdashs.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "org.sdashs.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#a00561",
          "icon": "./assets/favicon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
